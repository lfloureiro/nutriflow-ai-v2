# Application
APP_NAME=NutriFlow AI
APP_ENV=development
APP_DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Web
WEB_HOST=127.0.0.1
WEB_PORT=5173

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nutriflow
POSTGRES_USER=nutriflow
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://nutriflow:change_me@localhost:5432/nutriflow

# Security
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Locale
DEFAULT_LOCALE=pt-PT
DEFAULT_TIMEZONE=Europe/Lisbon

# Features
ENABLE_HEALTH_INTEGRATIONS=false
ENABLE_ML=false

# Restaurant discovery
RESTAURANT_DISCOVERY_ENABLED=true
RESTAURANT_APIFY_GOOGLE_ENABLED=true
RESTAURANT_APIFY_GOOGLE_URL=https://api.apify.com/v2/actors/compass~crawler-google-places/run-sync-get-dataset-items
RESTAURANT_APIFY_TIMEOUT_SECONDS=120
RESTAURANT_GOOGLE_PLACES_ENABLED=true
RESTAURANT_GOOGLE_PLACES_URL=https://places.googleapis.com/v1/places:searchText
RESTAURANT_DISCOVERY_NOMINATIM_URL=https://nominatim.openstreetmap.org
RESTAURANT_DISCOVERY_OVERPASS_URL=https://overpass-api.de/api/interpreter
RESTAURANT_DISCOVERY_USER_AGENT=NutriFlowAI/0.1 restaurant-discovery

# External provider secrets
# Development uses environment variables only. Production should use the configured vault adapter.
PROVIDER_SECRET_BACKEND=environment

# Apify Google Maps is the preferred Google restaurant discovery source when configured.
# Keep the real token only in a local untracked .env or production secret store.
NUTRIFLOW_APIFY_API_TOKEN=

# Direct Google Places remains a secondary Google discovery source.
NUTRIFLOW_GOOGLE_PLACES_API_KEY=

# USDA FoodData Central is used only for explicitly curated shared-ingredient matches.
# For initial exploration USDA documents DEMO_KEY with much lower rate limits; use a personal
# data.gov API key for normal development and never commit it.
NUTRIFLOW_FDC_API_KEY=

# Provider activation is deliberately separate from credential presence.
UBER_CONSUMER_DELIVERY_ENABLED=false
GLOVO_CONSUMER_DISCOVERY_ENABLED=false
BOLT_FOOD_CONSUMER_DISCOVERY_ENABLED=false

# Never commit real values. Fill only in a local untracked .env or production vault.
NUTRIFLOW_UBER_CLIENT_ID=
NUTRIFLOW_UBER_CLIENT_SECRET=
NUTRIFLOW_GLOVO_CLIENT_ID=
NUTRIFLOW_GLOVO_CLIENT_SECRET=
NUTRIFLOW_BOLT_FOOD_INTEGRATOR_ID=
NUTRIFLOW_BOLT_FOOD_SECRET_KEY=

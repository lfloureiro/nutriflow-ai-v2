# Application
APP_NAME=NutriFlow AI
APP_ENV=development
APP_DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Web
WEB_HOST=127.0.0.1
WEB_PORT=5173

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nutriflow
POSTGRES_USER=nutriflow
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://nutriflow:change_me@localhost:5432/nutriflow

# Security
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Locale
DEFAULT_LOCALE=pt-PT
DEFAULT_TIMEZONE=Europe/Lisbon

# Features
ENABLE_HEALTH_INTEGRATIONS=false
ENABLE_ML=false
